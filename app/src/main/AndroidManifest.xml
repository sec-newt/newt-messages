<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Every permission is listed, with why, in config/allowed-permissions.txt; the build fails
         if one appears that isn't there. No internet access. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <!-- Lets other apps signed with the Newt key (Newt Home) read how many messages are unread:
         only the number. "signature" means Android grants it to no other app, and nobody is asked. -->
    <permission
        android:name="${applicationId}.permission.UNREAD_COUNT"
        android:label="@string/unread_permission"
        android:description="@string/unread_permission_description"
        android:protectionLevel="signature" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Newt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Text this number" from other apps; required of a default messaging app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Incoming texts. Only Android itself (holding BROADCAST_SMS) can send these. -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Incoming picture and group messages. Only Android (BROADCAST_WAP_PUSH) can send these. -->
        <receiver
            android:name=".sms.MmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- "Reply with a message" from the phone app; only it holds SEND_RESPOND_VIA_MESSAGE. -->
        <service
            android:name=".sms.RespondService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <!-- The app's own reports and notification buttons; nothing outside can reach them. -->
        <receiver android:name=".sms.SentReceiver" android:exported="false" />
        <receiver android:name=".notify.ActionReceiver" android:exported="false" />
        <receiver android:name=".mms.MmsResultReceiver" android:exported="false" />

        <!-- The unread count for other Newt apps (see the permission above). Read-only. -->
        <provider
            android:name=".share.UnreadProvider"
            android:authorities="${applicationId}.unread"
            android:exported="true"
            android:readPermission="${applicationId}.permission.UNREAD_COUNT"
            android:writePermission="${applicationId}.permission.UNREAD_COUNT" />

        <!-- Hands one MMS file at a time to Android's MMS service (the phone process), which
             does the downloading and sending. Not exported; access is granted per file. -->
        <provider
            android:name=".mms.MmsFileProvider"
            android:authorities="${applicationId}.mmsfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_paths" />
        </provider>
    </application>

</manifest>
